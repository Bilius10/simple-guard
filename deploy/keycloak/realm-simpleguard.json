{
  "realm": "simpleguard",
  "enabled": true,
  "displayName": "SimpleGuard",
  "loginTheme": "keycloak",
  "roles": {
    "realm": [
      {
        "name": "simpleguard_admin",
        "description": "Administrador da instancia SimpleGuard"
      }
    ]
  },
  "clients": [
    {
      "clientId": "web-admin",
      "name": "SimpleGuard Web Admin",
      "description": "Cliente publico OIDC da interface administrativa",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://localhost/*",
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "https://localhost",
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost/*##http://localhost:4200/*"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "users": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "username": "admin",
      "email": "admin@simpleguard.local",
      "firstName": "SimpleGuard",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_SIMPLEGUARD_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "simpleguard_admin"
      ]
    }
  ]
}
