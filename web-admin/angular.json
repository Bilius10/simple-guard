{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "analytics": "330be638-c8c2-4dff-8296-8a44a6a5ebf8"
  },
  "newProjectRoot": "projects",
  "projects": {
    "web-admin": {
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "configurations": {
            "development": {
              "extractLicenses": false,
              "optimization": false,
              "sourceMap": true
            },
            "production": {
              "budgets": [
                {
                  "maximumError": "1MB",
                  "maximumWarning": "500kB",
                  "type": "initial"
                }
              ],
              "outputHashing": "all"
            }
          },
          "defaultConfiguration": "production",
          "options": {
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "styles": [
              "src/styles.css"
            ],
            "tsConfig": "tsconfig.app.json"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "web-admin:build:development"
            },
            "production": {
              "buildTarget": "web-admin:build:production"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverageExclude": [
              "src/app/**/*.spec.ts",
              "src/app/**/*.models.ts",
              "src/app/**/*.config.ts",
              "src/app/**/*.routes.ts"
            ],
            "coverageInclude": [
              "src/app/**/*.ts"
            ],
            "coverageReporters": [
              "html",
              "lcov",
              "text-summary"
            ],
            "coverageThresholds": {
              "branches": 100,
              "functions": 100,
              "lines": 100,
              "statements": 100
            },
            "runner": "vitest"
          }
        }
      },
      "prefix": "sg",
      "projectType": "application",
      "root": "",
      "sourceRoot": "src"
    }
  },
  "version": 1
}
