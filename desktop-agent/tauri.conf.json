{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "center": true,
        "fullscreen": false,
        "height": 640,
        "minHeight": 540,
        "minWidth": 420,
        "resizable": false,
        "title": "SimpleGuard Agent",
        "width": 520
      }
    ],
    "withGlobalTauri": true
  },
  "build": {
    "frontendDist": "./app"
  },
  "bundle": {
    "active": true,
    "targets": "all"
  },
  "identifier": "br.com.simpleguard.agent.desktop",
  "productName": "SimpleGuard Agent",
  "version": "0.1.0"
}
